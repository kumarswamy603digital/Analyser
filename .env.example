# Root environment template. Copy to .env (never commit real secrets).
# Backend and frontend each have their own .env.example with more specific keys.

# ---- Backend ----
# Comma-separated list of allowed CORS origins (frontend dev URLs)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Maximum characters accepted for a single translation/sentiment input
MAX_INPUT_CHARS=1000

# Inference device: cpu (gpu optional if CUDA torch is installed)
DEVICE=cpu

# Directory for the Hugging Face model cache (weights are NOT committed)
HF_HOME=./HF_HOME

# Optional: only needed for gated/private models. Leave empty for this project.
# Never commit a real token.
HF_TOKEN=

# ---- Frontend (see frontend/.env.example) ----
# Base URL the frontend uses to reach the backend API
VITE_API_BASE_URL=http://localhost:8000
