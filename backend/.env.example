# Backend environment template. Copy to backend/.env for local development.
# Do NOT commit real secrets.

# CORS: comma-separated allowed origins (the frontend dev server).
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000

# Max characters accepted per translation/sentiment input (413 beyond this).
MAX_INPUT_CHARS=1000

# Inference device: cpu (or cuda if a CUDA build of torch is installed).
DEVICE=cpu

# Local Hugging Face model cache directory (weights are not committed).
HF_HOME=./HF_HOME

# Optional token for gated/private models only. Leave empty for this project.
HF_TOKEN=

# Documented timeout policy: soft per-request inference limit in seconds.
INFERENCE_TIMEOUT_SECONDS=60

# Optional: preload the sentiment model at startup (slower start, faster first call).
PRELOAD_MODELS=false
